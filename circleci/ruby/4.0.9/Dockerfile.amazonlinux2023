###########################################################################
#
#--------------------------------------------------------------------------
# Image Setup
#--------------------------------------------------------------------------
#
# To change its version, see the available Tags on the Docker Hub:
#    https://hub.docker.com/r/fromscratch/ruby/tags/
#
# Note: Base Image name format fromscratch/ruby:{ruby-version}-amazonlinux{amazonlinux-version}-{ami-version}
#
# CircleCI で batch 用の tgz（vendor/bundle 入り）を作るためのイメージ。
# デプロイ先の AMI（darunia-terraformar の ec2_images.rails_ruby4_0_9。Amazon Linux 2023・
# Ruby 4.0.9 の AMI）と、OS・Ruby・MySQL クライアントをそろえる。
# AMI の Ruby は rbenv（ruby-build）で --enable-shared 付き。static の Ruby で作った native 拡張は
# extensions/x86_64-linux/4.0.0-static に置かれ、shared の Ruby からは未ビルドに見えるため、ここも --enable-shared にする。
# MySQL クライアントは AMI と同じ MySQL 8.0.39（libmysqlclient.so.21）。mariadb105 では
# mysql2 が libmariadb にリンクされ、AMI の上で読めない。
# OS のリリースも AMI と同じ AL2023 2023.12.20261109 に固定する（openssl-libs 3.5.8・glibc 2.34-231）。
# タグ「2023」のままだと AWS が新しいリリースを出すたびに OpenSSL・glibc が AMI とずれ、
# ここで作った native 拡張が AMI の上で読めなくなる恐れがある。AMI の土台を上げるときは、ここも一緒に上げる。
#
###########################################################################

ARG AL2023_RELEASE=2023.12.20261109
FROM public.ecr.aws/amazonlinux/amazonlinux:${AL2023_RELEASE}.0

LABEL maintainer "from scratch Co.Ltd."

###########################################################################
# Versions:
###########################################################################

ENV RUBY_MAJOR 4.0
ENV RUBY_VERSION 4.0.9
# https://cache.ruby-lang.org/pub/ruby/index.txt の ruby-4.0.9.tar.gz の sha256
ENV RUBY_SHA256 c35350682ff050b79702d57ade4516e7336063f510155d19fb2fb5b3f3909511
# AMI（今の rails_ruby4_0 から作る rails_ruby4_0_9）の mysql-community-* の版
ENV MYSQL_VERSION 8.0.39

###########################################################################
# Set Timezone
###########################################################################

ENV TZ Asia/Tokyo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

###########################################################################
# OS release (AMI と同じリリースであること。dnf はこのリリースのリポジトリから入れる):
###########################################################################

ARG AL2023_RELEASE
RUN [ "$(rpm -q --qf '%{VERSION}' system-release)" = "$AL2023_RELEASE" ] || \
      { echo "system-release is not ${AL2023_RELEASE}: $(rpm -q system-release)"; exit 1; }

###########################################################################
# Common:
###########################################################################

RUN dnf install -y git gcc gcc-c++ make autoconf tar gzip bzip2 which findutils procps-ng sudo openssh-clients \
      openssl openssl-devel libyaml libyaml-devel libffi-devel zlib-devel readline-devel \
      unixODBC unixODBC-devel shared-mime-info && \
    dnf clean all

###########################################################################
# MySQL client (MySQL 8.0.39 / libmysqlclient.so.21):
###########################################################################

RUN rpm --import https://repo.mysql.com/RPM-GPG-KEY-mysql-2023 && \
    dnf install -y https://dev.mysql.com/get/mysql80-community-release-el9-5.noarch.rpm && \
    dnf install -y mysql-community-client-$MYSQL_VERSION mysql-community-devel-$MYSQL_VERSION && \
    dnf clean all

###########################################################################
# Ruby:
###########################################################################

RUN mkdir -p /build/ruby && \
    curl -fsSL -o /build/ruby.tar.gz https://cache.ruby-lang.org/pub/ruby/$RUBY_MAJOR/ruby-$RUBY_VERSION.tar.gz && \
    echo "$RUBY_SHA256  /build/ruby.tar.gz" | sha256sum -c - && \
    tar -C /build/ruby -xzf /build/ruby.tar.gz && \
    cd /build/ruby/ruby-$RUBY_VERSION && \
    ./configure --prefix=/usr/local --enable-shared --disable-install-doc && \
    make -j"$(nproc)" && \
    make install && \
    rm -fr /build && \
    ldconfig

###########################################################################
# update sudoers
###########################################################################

RUN sed -i "/secure_path/c\Defaults    secure_path = $PATH" /etc/sudoers

WORKDIR /target

CMD ["/bin/bash"]
